# Copy to .env and adjust. Defaults match docker-compose.yml.

DJANGO_SECRET_KEY=dev-only-not-secret
DJANGO_DEBUG=1
DJANGO_SETTINGS_MODULE=config.settings.dev

# Off the default ports so RefBot does not fight anything already on 5432 / 6379.
# Change the pair here and in docker-compose.yml together if these clash too.
POSTGRES_PORT=5442
REDIS_PORT=6389

DATABASE_URL=postgres://refbot:refbot@localhost:5442/refbot
REDIS_URL=redis://localhost:6389

# AI referee (phase 3). Get a key at https://aistudio.google.com/apikey
REFEREE_API_KEY=
REFEREE_MODEL=gemini-3.5-flash-lite
REFEREE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
