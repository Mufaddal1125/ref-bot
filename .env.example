# Copy to .env and adjust. Defaults match docker-compose.yml.

DJANGO_SECRET_KEY=dev-only-not-secret
DJANGO_DEBUG=1
DJANGO_SETTINGS_MODULE=config.settings.dev

DATABASE_URL=postgres://refbot:refbot@localhost:5432/refbot
REDIS_URL=redis://localhost:6379

# AI referee (phase 3). Leave the key blank to use the offline fake referee.
OPENROUTER_API_KEY=
REFEREE_MODEL=openai/gpt-4o-mini
REFEREE_FAKE=0
