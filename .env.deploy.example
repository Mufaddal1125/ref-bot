# Copy to .env.deploy. scripts/deploy-local.ps1 does that for you and fills in a
# secret key; REFEREE_API_KEY is the only value that has to be yours.

DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=*
POSTGRES_PASSWORD=refbot

# The port Caddy publishes on this machine. 80 gives the room a bare IP to type;
# use 8080 if something already owns 80 (IIS, and Windows' http.sys, often do).
HTTP_PORT=80

# AI referee (phase 3). Get a key at https://aistudio.google.com/apikey
REFEREE_API_KEY=
REFEREE_MODEL=gemini-3.5-flash-lite
REFEREE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
